# Copy to backend/.env and fill in. backend/.env is git-ignored and loaded automatically.

# --- LLM (Claude) --------------------------------------------------------------
# Required for the AI features: LLM extraction fallback, exception copilot, llm-benchmark.
# Get a key at https://console.anthropic.com/ . Without it everything else still runs
# (deterministic rules); the AI features report "not configured".
ANTHROPIC_API_KEY=

# Optional overrides (defaults live in configs/default.json -> "llm")
# AP_LLM_MODEL=claude-opus-5-5
# AP_LLM_EXTRACTION_EFFORT=medium      # low | medium | high | xhigh | max
# AP_LLM_COPILOT_EFFORT=medium

# --- API server ----------------------------------------------------------------
# AP_API_HOST=127.0.0.1
# AP_API_PORT=8000
